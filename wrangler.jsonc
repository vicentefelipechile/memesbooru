{
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "memesbooru",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "dist/client/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "memesbooru",
			"database_id": "c664e6f4-34f8-46fc-a1b8-4344dc8813b2",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "memesbooru-media"
		},
	],
	"images": {
		"binding": "IMAGES"
	},
	"media": {
		"binding": "MEDIA",
		"remote": true
	},
	"queues": {
		"producers": [
			{
				"binding": "MEDIA_QUEUE",
				"queue": "memesbooru-media"
			}
		],
		"consumers": [
			{
				"queue": "memesbooru-media",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "memesbooru-dlq"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"ratelimits": [
		{
			"name": "RL_GLOBAL",
			"namespace_id": "1001",
			"simple": {
				"limit": 500,
				"period": 60
			}
		},
		{
			"name": "RL_STRICT",
			"namespace_id": "1002",
			"simple": {
				"limit": 1,
				"period": 60
			}
		},
		{
			"name": "RL_MEDIUM",
			"namespace_id": "1003",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "RL_LOGIN",
			"namespace_id": "1004",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}
