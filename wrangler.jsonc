{
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memesbooru",
  "main": "src/server/entrypoint.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memesbooru-db",
      "database_id": "local-dev-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "memesbooru-media" },
    { "binding": "QUARANTINE_BUCKET", "bucket_name": "memesbooru-quarantine" }
  ],
  "queues": {
    "producers": [{ "binding": "MEDIA_QUEUE", "queue": "memesbooru-media" }],
    "consumers": [{ "queue": "memesbooru-media", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "memesbooru-dlq" }]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
